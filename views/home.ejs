<%- include("partials/header") %>

<!-- Hero Section avec header large et image exotique -->
<section class="hero">
  <div class="hero-content">
    <h1>Explorez le Monde</h1>
    <p>Des voyages sur mesure pour vivre vos rêves d'aventure et d'évasion. Laissez-vous inspirer par des destinations extraordinaires.</p>
    
    <!-- Moteur de recherche de voyages visible et interactif -->
    <form class="search-form" id="searchForm">
      <input 
        type="text" 
        placeholder="🔍 Où souhaitez-vous partir ?" 
        id="destination"
        required
        autocomplete="off"
      >
      <input 
        type="date" 
        id="departureDate"
        required
      >
      <select id="duration" required>
        <option value="">Durée</option>
        <option value="3">3 jours</option>
        <option value="5">5 jours</option>
        <option value="7">7 jours</option>
        <option value="10">10 jours</option>
        <option value="14">14+ jours</option>
      </select>
      <button type="submit">
        <span class="search-icon">✈</span>
        Rechercher
      </button>
    </form>
  </div>
</section>

<!-- Destinations populaires avec photos attractives -->
<section class="destinations">
  <h2>Destinations Populaires</h2>
  <div class="cards">
    <div class="card">
      <div class="card-image">
        <img 
          src="data:image/jpeg;base64," 
          alt="Plages paradisiaques"
          loading="lazy"
        >
      </div>
      <div class="card-content">
        <h3>Plages de San Pedro</h3>
        <p>Détente absolue et paysages paradisiaques. Des eaux turquoise et des plages de sable fin vous attendent pour une évasion parfaite.</p>
        <div class="card-price">À partir de 2 000Fcfa</div>
        <a href="#" class="card-link">Découvrir →</a>
      </div>
    </div>
    
    <div class="card">
      <div class="card-image">
        <img 
          src="https://cdn.prod.website-files.com/6369140bed4d3277b209e528/64df58f38fc93990c07df654_1.jpg" 
          alt="Montagnes"
          loading="lazy"
        >
      </div>
      <div class="card-content">
        <h3>Montagnes de Man</h3>
        <p>Aventure et trekking pour les passionnés de nature. Des sentiers magnifiques au cœur d'une biodiversité exceptionnelle.</p>
        <div class="card-price">À partir de 5 000Fcfa</div>
        <a href="#" class="card-link">Découvrir →</a>
      </div>
    </div>
    
    <div class="card">
      <div class="card-image">
        <img 
          src="https://discover-ivorycoast.com/wp-content/uploads/2019/01/basilique-Notre-Dame-de-la-Paix-de-Yamoussoukro-2.jpg" 
          alt="Ville historique"
          loading="lazy"
        >
      </div>
      <div class="card-content">
        <h3>Yamoussoukro</h3>
        <p>Culture et patrimoine historique fascinants. Découvrez l'histoire riche et les monuments emblématiques de cette ville unique.</p>
        <div class="card-price">À partir de 4 000Fcfa</div>
        <a href="#" class="card-link">Découvrir →</a>
      </div>
    </div>
    
    <div class="card">
      <div class="card-image">
        <img 
          src="data:image/jpeg;base64," 
          alt="Safari"
          loading="lazy"
        >
      </div>
      <div class="card-content">
        <h3>Safari en Savane</h3>
        <p>Rencontrez la faune sauvage dans son habitat naturel. Une expérience inoubliable au cœur de la nature africaine.</p>
        <div class="card-price">À partir de 15 000Fcfa</div>
        <a href="#" class="card-link">Découvrir →</a>
      </div>
    </div>
    
    <div class="card">
      <div class="card-image">
        <img 
          src="data:image/jpeg;base64," 
          alt="Ile tropicale"
          loading="lazy"
        >
      </div>
      <div class="card-content">
        <h3>Iles Tropicales</h3>
        <p>Évadez-vous sur des îles paradisiaques où chaque instant devient un souvenir précieux de détente et de beauté.</p>
        <div class="card-price">À partir de 10 000Fcfa</div>
        <a href="#" class="card-link">Découvrir →</a>
      </div>
    </div>
    
    <div class="card">
      <div class="card-image">
        <img 
          src="https://lepetitjournal.com/sites/default/files/2020-02/ACTU-0.8879127733319254-39mrnosdxpv0367ns0e1og.jpg" 
          alt="Aventure"
          loading="lazy"
        >
      </div>
      <div class="card-content">
        <h3>Aventure Écotourisme</h3>
        <p>Explorez des réserves naturelles exceptionnelles tout en respectant l'environnement. Voyagez responsable et éthique.</p>
        <div class="card-price">À partir de 20 000Fcfa</div>
        <a href="#" class="card-link">Découvrir →</a>
      </div>
    </div>
  </div>
</section>

